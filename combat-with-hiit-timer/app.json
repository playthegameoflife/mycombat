{
  "expo": {
    "name": "MyCombat",
    "slug": "mycombat",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "android": {
      "package": "com.gamifiedlivingapps.mycombat",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": []
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gamifiedlivingapps.mycombat"
    },
    "plugins": [
      "expo-av",
      "expo-sensors",
      "expo-store-review"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
